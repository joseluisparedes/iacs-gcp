# ==============================================================================
# IACS ENTERPRISE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Entorno de Ejecución (local | development | staging | production)
ENVIRONMENT=local
DEBUG=true

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL 17)
# ------------------------------------------------------------------------------
POSTGRES_USER=iacs_user
POSTGRES_PASSWORD=iacs_secure_password_dev
POSTGRES_DB=iacs_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://iacs_user:iacs_secure_password_dev@postgres:5432/iacs_db

# ------------------------------------------------------------------------------
# 2. Backend (FastAPI 0.116.x / Python 3.13)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 3. Frontend (Nuxt 4.x / Vue 3.x / Node 24)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NUXT_PUBLIC_APP_NAME="IACS Enterprise"

# ------------------------------------------------------------------------------
# 4. Proveedor de Identidad (SecureAuth / IdP Corporativo)
# ------------------------------------------------------------------------------
# En entorno local se puede activar el mock dev issuer
USE_AUTH_MOCK=true
IDP_ISSUER_URL=https://login.corporativo.com
IDP_CLIENT_ID=iacs-app-client-id
IDP_CLIENT_SECRET=iacs-app-client-secret
IDP_AUDIENCE=iacs-api

# ------------------------------------------------------------------------------
# 5. Inteligencia Artificial (Google Cloud Vertex AI)
# ------------------------------------------------------------------------------
# En local se puede usar MOCK o credenciales de Service Account de GCP
USE_AI_MOCK=false
GCP_PROJECT_ID=iacs-enterprise-prod
GCP_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json

# ------------------------------------------------------------------------------
# 6. Almacenamiento de Archivos (Google Cloud Storage)
# ------------------------------------------------------------------------------
USE_STORAGE_MOCK=true
GCS_BUCKET_DOCUMENTS=iacs-documents-storage
GCS_BUCKET_AVATARS=iacs-avatars-storage
LOCAL_STORAGE_PATH=/app/uploads

# ------------------------------------------------------------------------------
# 7. Servicio de Correo (Microsoft 365 / Exchange Online)
# ------------------------------------------------------------------------------
USE_EMAIL_MOCK=true
M365_TENANT_ID=your-m365-tenant-id
M365_CLIENT_ID=your-m365-client-id
M365_CLIENT_SECRET=your-m365-client-secret
EMAIL_SENDER=no-reply@iacs.empresa.com

# ------------------------------------------------------------------------------
# 8. Observabilidad y Monitoreo
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGS=true
DYNATRACE_API_TOKEN=
DYNATRACE_ENVIRONMENT_ID=
